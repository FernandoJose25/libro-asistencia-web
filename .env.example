NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Credenciales OAuth propias de Google (Google Cloud Console → Credenciales →
# ID de cliente de OAuth → tipo "Aplicación web"). Ya no se usa el proveedor
# de Google de Supabase para esto: el login del profesor es email/contraseña,
# y conectar Drive es un flujo aparte manejado por esta app (ver
# app/api/google/connect y app/api/google/callback).
# URI de redirección autorizada a registrar en Google Cloud:
#   {NEXT_PUBLIC_SITE_URL}/api/google/callback  (y http://localhost:3000/api/google/callback para pruebas)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resumen con IA de la asistencia de un grupo (https://console.groq.com/keys)
GROQ_API_KEY=